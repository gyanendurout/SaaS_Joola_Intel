# Build output
.next/
node_modules/

# Env vars (NEVER commit)
.env
.env.local
.env.*.local
.env.development
.env.production

# Claude Code — keep portable team artifacts (.claude/agents, .claude/commands, .claude/settings.json)
# but ignore local-only state (skills cache, scheduled tasks, per-user overrides).
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/skills/
.claude/projects/
.claude/sessions/
.claude/state/

# QA artifacts
qa/playwright-report/
qa/test-results/
frontend/qa/playwright-report/
frontend/qa/test-results/

# Pre-push QA flag (transient)
joola-intel-qa-*.flag

# Python bytecode
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# TypeScript generated
tsconfig.tsbuildinfo

# Pipeline state (transient — written by run_resumable.py at cwd)
**/pipeline_state.json
**/smoke_test_v2_results.json

# Large binary/archive artifacts
*.zip
*.docx
SaaS Marketing/

# Ruflo swarm working directories
.claude-flow/
.swarm/
ruvector.db
logs/
*.prev

# Licensed third-party research (Particl exports: .docx reports + dashboard
# screenshots). Kept out of git deliberately — it is a paid vendor's material
# and 18 MB of binaries would live in history forever.
DATA/

# Stray root manifest from a tool run. The application manifest is frontend/package.json.
/package.json
/package-lock.json

# Generated knowledge-graph output from the graphify tool (5.5 MB of AST cache).
# Regenerate with /graphify; never belongs in history.
graphify-out/
